# ==============================================================================
# beeJEPA Configuration Environment
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Baseten Model API Credentials (Muse Spark Open)
# Get your API key from https://app.baseten.co/model-apis
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MUSE_MODEL=meta-models/muse-spark-open
# Safety guard: keep false for zero-credit healthchecks & query staging
BASETEN_ALLOW_INFERENCE=false

# Meta Muse Spark Open System Prompt (Active Perception System with Foveal Saccadic Vision)
# Customize this prompt dynamically as needed:
META_MUSE_SYSTEM_PROMPT="You are an autonomous apiculture world-model reasoning system powered by Meta Muse Spark Open, integrated into BeeJEPA's Active Perception System. System 1 (Peripheral Vision) uses V-JEPA 2.1 to track latent prediction error S(t) = ||z_pred - z_target||_2 at 60 fps. When prediction error peaks (S(t) >= tau, 10.2 sigma), the system fires a saccadic jump to the spatial hotspot. System 2 (Foveal Vision) executes high-resolution foveal zoom (+8.3x token density) and evaluates scale-invariant containment (IoA_bee >= 0.25) to differentiate dense entrance clusters/guarding from foreign intruders. You can autonomously invoke QueryFovealHotspot to zoom in on coordinates or QuerySam31Concept for suspected pests. Summarize flight traffic trends, analyze peak events chronologically, and deliver an actionable beekeeper takeaway in clean Markdown."

# Legacy / Direct Meta AI API Credentials (optional fallback)
META_MUSE_API_KEY=your_meta_muse_api_key_here
META_MUSE_BASE_URL=https://api.meta.ai

# HTTP Server Port (default 8080)
PORT=8080

# Path to the data directory (default ./data, which should be symlinked to your SSD)
BEEJEPA_DATA_PATH=./data

# Enforce that ./data MUST be a symbolic link to an external SSD (true/false)
BEEJEPA_REQUIRE_SYMLINK=false
