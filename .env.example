# ==============================================================================
# beeJEPA Configuration Environment (Raspberry Pi ARM64 + External SSD)
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Baseten Model API Credentials (Muse Spark Open)
# Get your API key from https://app.baseten.co/model-apis
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MUSE_MODEL=meta-models/muse-spark-open-1026
BASETEN_ALLOW_INFERENCE=true

# Direct Meta AI API Credentials (SAM 3.1 & Muse Fallback)
META_MUSE_API_KEY=your_meta_muse_api_key_here
META_MUSE_BASE_URL=https://api.meta.ai

# Redis L1 + SQLite WAL L2 Live Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=604800

# Optional custom system prompt override (leave blank to use the built-in structured <REPORT>/<SPOKEN> prompt)
META_MUSE_SYSTEM_PROMPT=

# HTTP Server Port (default 8080)
PORT=8080

# Path to the data directory (default ./data -> symlinked to /mnt/onlypits/beeJEPA on Raspberry Pi SSD)
BEEJEPA_DATA_PATH=./data
# Optional explicit path for SQLite WAL database on ext4 partition (e.g. /mnt/onlypits-ext4/beejepa/state.db)
BEEJEPA_SQLITE_PATH=

# Enforce that ./data MUST be a symbolic link to an external SSD (true/false)
BEEJEPA_REQUIRE_SYMLINK=false

# Off-Heap FFM Ring Buffer Tuning
BEEJEPA_RING_BUFFER_CAPACITY=64
BEEJEPA_RING_BUFFER_MAX_PAYLOAD_BYTES=393216
